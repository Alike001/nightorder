{
  "name": "nightorder",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=22.14.0",
    "pnpm": ">=10.18.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "pnpm --filter @nightorder/worker dev",
    "format:check": "prettier --check \"**/*.{js,mjs,cjs,ts,json,yaml,yml}\"",
    "lint": "eslint .",
    "proof:runs": "pnpm --filter @nightorder/worker exec tsx ../../scripts/run-e2e-proofs.ts && pnpm exec prettier --write \"evidence/runs/*.json\"",
    "test": "vitest run",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.18.12",
    "eslint": "^9.39.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vitest": "^3.2.4"
  }
}
